# Copy to .env and fill locally. Never commit .env or real secrets.

# Lab VPN / jump box (paths on the Fedora workstation)
VPN_CONFIG_PATH=/home/mania/Documents/server/Aheed_VPN_aheed.ovpn
VPN_AUTH_PATH=/home/mania/Documents/server/openvpn-auth.txt
VPN_LOG_PATH=/home/mania/Documents/server/openvpn.log
VPN_PID_PATH=/home/mania/Documents/server/openvpn.pid
RDP_SCRIPT_PATH=/home/mania/.config/freerdp/jumpbox.sh
RDP_PID_PATH=/home/mania/Documents/server/jumpbox-rdp.pid
JUMPBOX_RDP_TARGET=172.30.227.1

# NetOsis runtime
NETOSIS_DATA_DIR=./data
NETOSIS_HOST_CONFIG=./deception/hosts/enterprise-web.yml
NETOSIS_SECOND_HOST=./deception/hosts/finance-db.yml

# LLM / RAG — mock (CI) | qwen | ollama | http
# CPU lab default model: qwen2.5:3b (see docs/llm-local.md)
NETOSIS_LLM_MODE=mock
NETOSIS_LLM_BASE_URL=http://127.0.0.1:11434/v1
NETOSIS_LLM_MODEL=qwen2.5:3b
NETOSIS_LLM_API_KEY=
NETOSIS_LLM_MAX_TOKENS=256
NETOSIS_LLM_TEMPERATURE=0.2
NETOSIS_LLM_TIMEOUT=60
NETOSIS_RAG_TOP_K=4
# Embeddings: auto|minilm|hash
NETOSIS_EMBED_MODE=auto
NETOSIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NETOSIS_RETRIEVER=hybrid
