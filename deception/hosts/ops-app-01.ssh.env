# SSH honeypot env for CT 105 — ops-srv-01 (profile name ops-app-01)
# IP: 192.168.20.10/24  VLAN 20  GW 192.168.20.254
# Host state YAML: deception/hosts/ops-app.yml
# Usage on CT:
#   bash /opt/netosis/scripts/lab-bootstrap-remote.sh ops-app-01

NETOSIS_DATA_DIR=./data
NETOSIS_HOST_CONFIG=./deception/hosts/ops-app.yml
NETOSIS_SECOND_HOST=./deception/hosts/finance-db.yml

NETOSIS_LLM_MODE=qwen
NETOSIS_LLM_BASE_URL=http://192.168.40.31:11434/v1
NETOSIS_LLM_MODEL=qwen2.5:0.5b
NETOSIS_LLM_API_KEY=
NETOSIS_LLM_MAX_TOKENS=96
NETOSIS_LLM_TEMPERATURE=0.2
NETOSIS_LLM_TIMEOUT=15
# Instant, consistent answers; pre-fill with scripts/llm_prewarm.py (qwen2.5:3b)
NETOSIS_LLM_CACHE=1
NETOSIS_RAG_TOP_K=4
NETOSIS_RAG_MULTI_ACTOR=1
NETOSIS_EMBED_MODE=hash
NETOSIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NETOSIS_RETRIEVER=hybrid
# [llm] prefix on LLM answers for demos; set 0 when facing real attackers
NETOSIS_LLM_DEMO_MARK=1
NETOSIS_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.10

NETOSIS_SSH_PORT=2222
NETOSIS_SSH_BIND=0.0.0.0
NETOSIS_SSH_USER=admin
NETOSIS_SSH_PASSWORD=admin123

LAB_SSH_HOST=192.168.20.10
LAB_SSH_USER=root
LAB_SSH_PORT=22
LAB_REMOTE_DIR=/opt/netosis
LAB_SSH_JUMP=
