{
  "$comment": "Single source of truth for the NexusCorp lab topology. Read by the intelligence plane, rendered by the dashboard, and used to generate the PDF figures, so all three cannot disagree.",
  "org": {
    "name": "NexusCorp Industrial Systems",
    "domain": "nexuscorp.example"
  },
  "zones": [
    {
      "id": "internet",
      "label": "Internet",
      "cidr": "203.0.113.0/24",
      "trust": "hostile",
      "row": 0,
      "note": "TEST-NET-3, simulated. No bridge in this lab reaches the real Internet."
    },
    {
      "id": "dmz",
      "label": "DMZ",
      "cidr": "172.31.10.0/24",
      "trust": "low",
      "row": 2,
      "note": "Public-facing real services."
    },
    {
      "id": "transit",
      "label": "Transit",
      "cidr": "172.31.99.0/24",
      "trust": "infrastructure",
      "row": 2,
      "note": "Perimeter firewall to core firewall."
    },
    {
      "id": "corp",
      "label": "Corporate LAN",
      "cidr": "10.10.20.0/24",
      "trust": "medium",
      "row": 4,
      "note": "Reachable from the deception zone on decoy ports only."
    },
    {
      "id": "datacenter",
      "label": "Datacenter",
      "cidr": "10.10.30.0/24",
      "trust": "high",
      "row": 5,
      "note": "Never reachable from the deception zone. Containment invariant."
    },
    {
      "id": "deception",
      "label": "Deception",
      "cidr": "10.200.2.0/24",
      "trust": "adversary-facing",
      "row": 4,
      "note": "CyberSnare surfaces. Source addresses are never NATed into this zone."
    },
    {
      "id": "egress",
      "label": "Egress",
      "cidr": "10.200.3.0/24",
      "trust": "contained",
      "row": 5,
      "note": "Stage-0 sinkhole. Attached to neither firewall."
    },
    {
      "id": "mgmt",
      "label": "Management",
      "cidr": "10.200.1.0/24",
      "trust": "control",
      "row": 3,
      "note": "Control plane. Appears in no forward rule on either firewall."
    }
  ],
  "firewalls": [
    {
      "id": "edge-fw",
      "label": "Perimeter firewall",
      "role": "edge",
      "table": "cs_edge",
      "zones": [
        "internet",
        "dmz",
        "transit",
        "mgmt"
      ],
      "addresses": {
        "internet": "203.0.113.2",
        "dmz": "172.31.10.2",
        "transit": "172.31.99.2",
        "mgmt": "10.200.1.30"
      }
    },
    {
      "id": "core-fw",
      "label": "Core firewall",
      "role": "core",
      "table": "cs_core",
      "zones": [
        "transit",
        "corp",
        "datacenter",
        "deception",
        "mgmt"
      ],
      "addresses": {
        "transit": "172.31.99.3",
        "corp": "10.10.20.2",
        "datacenter": "10.10.30.2",
        "deception": "10.200.2.2",
        "mgmt": "10.200.1.31"
      }
    }
  ],
  "published": [
    {
      "vip": "203.0.113.10",
      "name": "www.nexuscorp.example",
      "ports": [
        80,
        443
      ],
      "target": "172.31.10.20",
      "kind": "real"
    },
    {
      "vip": "203.0.113.11",
      "name": "mail.nexuscorp.example",
      "ports": [
        80,
        443
      ],
      "target": "172.31.10.21",
