  "policy_edges": [
    {
      "from": "internet",
      "to": "dmz",
      "verdict": "allow",
      "detail": "published ports only, via DNAT"
    },
    {
      "from": "internet",
      "to": "deception",
      "verdict": "allow",
      "detail": "dev.nexuscorp.example 22/443, source address preserved"
    },
    {
      "from": "internet",
      "to": "corp",
      "verdict": "deny",
      "detail": "no published service"
    },
    {
      "from": "internet",
      "to": "datacenter",
      "verdict": "deny",
      "detail": "no published service"
    },
    {
      "from": "dmz",
      "to": "internet",
      "verdict": "allow",
      "detail": "outbound"
    },
    {
      "from": "dmz",
      "to": "corp",
      "verdict": "restricted",
      "detail": "directory, file and database ports blocked"
    },
    {
      "from": "corp",
      "to": "datacenter",
      "verdict": "allow",
      "detail": "ordinary business traffic"
    },
    {
      "from": "corp",
      "to": "internet",
      "verdict": "allow",
      "detail": "outbound browsing"
    },
    {
      "from": "deception",
      "to": "corp",
      "verdict": "restricted",
      "detail": "decoy ports 80/139/389/445/3389 \u2014 the L3 internal hop"
    },
    {
      "from": "deception",
      "to": "datacenter",
      "verdict": "containment",
      "detail": "never \u2014 recorded as a containment violation"
    },
    {
      "from": "deception",
      "to": "internet",
      "verdict": "containment",
      "detail": "never \u2014 egress goes to the sinkhole instead"
    },
    {
      "from": "deception",
      "to": "egress",
      "verdict": "allow",
      "detail": "stage-0 sinkhole, off both firewalls"
    }
  ]
}
