# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Lab runtime (system of record stays on disk, not in git)
data/events/*.jsonl
data/events/*.jsonl.*
data/manifests/current.json
data/manifests/current.json.tmp
data/zeek/*.log
data/zeek/*.log.*
data/zeek/*.json
data/collection/
data/milestone1-report.json
data/metrics/*.json
data/metrics/*.tmp

# Compose local overrides (often contain host-only bind paths)
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# Exported container bundles (offline transfer)
dist/

# Saved / exported container images and storage dumps
*.tar
*.tar.gz
*.oci
*.oci.tar
*.img
*.qcow2
overlay/
overlay2/
docker-data/
podman-data/
.local/share/containers/
containers/storage/
.podman/

# Duplicate of docs/ — keep the source tree, not the zip
docs.zip

# Trained model checkpoints — derived from this machine's lab traffic,
# regenerate with `./cs train-gnn` rather than shipping one
data/models/*.pt
data/models/*.pth

# Editor-specific tool bundles (skills, agent config) — not project source
.cursor/
.claude/settings.local.json


# Office / generated docs — source of truth is markdown + figures
*.doc
*.docx
*.docm
~$*
*.pdf
docs/build/*.txt

# Dashboard UI build artefacts
deploy/dashboard-ui/node_modules/
deploy/dashboard/assets/
containers/kubectl-linux-amd64

# Generated k8s manifests — derived from config/topology.json and config/*.json
# by deploy/k8s/generate-*.py; deploy/k8s/deploy.sh regenerates them, so a
# checked-in copy would just go stale relative to the generators.
deploy/k8s/generated/
