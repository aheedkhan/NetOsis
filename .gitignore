.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Lab runtime (system of record stays on disk, not in git)
data/events/*.jsonl
data/events/*.jsonl.*
data/manifests/current.json
data/manifests/current.json.tmp
data/zeek/*.log
data/zeek/*.log.*
