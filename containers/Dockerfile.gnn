FROM python:3.12-slim

WORKDIR /app

# CPU-only torch (~200 MB) — lab GNN runs on CPU, no CUDA needed.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY lib /app/lib
COPY services/gnn_scorer /app/services/gnn_scorer

ENV PYTHONPATH=/app/lib:/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

CMD ["python", "-m", "services.gnn_scorer"]
