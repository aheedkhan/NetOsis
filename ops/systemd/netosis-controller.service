[Unit]
Description=NetOsis controller + SOC dashboard (telemetry ingest, honeypot power, UI)
Documentation=file:///opt/netosis/docs/soc-dashboard.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netosis
Group=netosis
WorkingDirectory=/opt/netosis
# controller/.env holds NETOSIS_INGEST_TOKEN and the Proxmox API token (mode 600)
EnvironmentFile=-/opt/netosis/controller/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /opt/netosis/controller/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/netosis/data

[Install]
WantedBy=multi-user.target
